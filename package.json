{
  "name": "thymos",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contracts": "forge build",
    "deploy:somnia": "forge build && tsx agents/src/deploy-somnia.ts",
    "test": "forge test",
    "demo": "tsx agents/src/demo.ts",
    "demo:once": "DEMO_ONCE=1 tsx agents/src/demo.ts",
